# ==========================================
# AxonBot Configuration Template
# ==========================================

# Telegram Bot Token (получите у @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Telegram Admin User ID (для получения заявок на доступ и команды /reboot)
ADMIN_ID=123456789

# n8n RAG Webhook URL
# Для локального запуска: http://localhost:5678/webhook/rag
# Для Docker-сети: http://host.docker.internal:5678/webhook/rag или http://n8n:5678/webhook/rag
N8N_RAG_URL=http://localhost:5678/webhook/rag

# Confluence Cloud API Credentials (для скачивания медиа в память и RAG-синхронизации)
CONFLUENCE_BASE_URL=https://docs.yourcompany.internal
CONFLUENCE_URL=https://docs.yourcompany.internal
CONFLUENCE_EMAIL=user@example.com
CONFLUENCE_API_TOKEN=your_atlassian_api_token
CONFLUENCE_SPACE_KEY=BIM_KR
CONFLUENCE_PARENT_PAGE_ID=590112

# OpenAI API Key (для VLM-обогащения скриншотов)
OPENAI_API_KEY=sk-proj-your_openai_api_key

# Confluence Knowledge Base Invite Link (для одобренных соискателей с email)
CONFLUENCE_INVITE_LINK=https://id.atlassian.com/invite/p/confluence?id=your_invite_token
